# Add the deployed Diana contract address to enable on-chain actions.
VITE_QORESPLIT_ADDRESS=
# Used only by npm run deploy. Use a funded, dedicated Diana EVM test account.
# Register its PQ key and open an EVM window that allows contract creation.
DIANA_DEPLOYER_KEY=

# Used only by the signing tool (npm run pq). Your own collaborator account:
# either the mnemonic (with an optional account index)...
QORE_MNEMONIC=
QORE_ACCOUNT_INDEX=0
# ...or the EVM private key together with its PQC recovery code.
PRIVATE_KEY=
QORE_PQC_RECOVERY_CODE=

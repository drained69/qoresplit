{
  "name": "treaty",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run compile && vite",
    "build": "npm run compile && vite build && node scripts/build-worker.mjs",
    "preview": "vite preview",
    "compile": "node scripts/compile.mjs",
    "test": "npm run compile && node --test test/treaty.test.mjs test/native.test.mjs",
    "e2e": "npm run compile && node --test test/e2e.test.mjs",
    "demo": "npm run compile --silent && node --env-file-if-exists=.env.diana examples/agents-demo.mjs",
    "accounts": "npm run compile --silent && node scripts/accounts.mjs",
    "check:diana": "npm run compile --silent && node scripts/check-diana.mjs",
    "deploy": "npm run compile && node --env-file-if-exists=.env scripts/deploy.mjs",
    "pq": "npm run compile --silent && node --env-file-if-exists=.env scripts/treaty.mjs"
  },
  "dependencies": {
    "@cosmjs/stargate": "0.39.0",
    "@qorechain/evm": "0.14.0",
    "@qorechain/sdk": "0.14.0",
    "@scure/base": "1.2.6",
    "viem": "2.55.18"
  },
  "devDependencies": {
    "@qorechain/qoresign": "0.2.0",
    "hardhat": "2.30.0",
    "solc": "0.8.39",
    "vite": "6.4.5"
  },
  "overrides": {
    "rollup": "4.67.4",
    "esbuild": "0.25.12",
    "solc": {
      "tmp": "0.2.7"
    }
  }
}
